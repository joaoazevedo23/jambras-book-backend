{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@prisma-client": ["src/generated/prisma"],
      "@prisma-client/*": ["src/generated/prisma/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}